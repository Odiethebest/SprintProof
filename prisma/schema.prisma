generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  LEAD
  MEMBER
  INSTRUCTOR
}

enum ActivityType {
  COMMIT
  PR_OPENED
  PR_MERGED
  REVIEW
}

// GitHub's review.state for a submitted review (#57). Every state counts
// under R3; the state only changes the activity feed's wording.
enum ReviewState {
  APPROVED
  CHANGES_REQUESTED
  COMMENTED
}

enum RetroColumn {
  WENT_WELL
  TO_IMPROVE
}

model User {
  id          String       @id @default(cuid())
  githubId    String       @unique @map("github_id")
  // Nullable: after a GitHub rename the login can move to another account (#6).
  githubLogin String?      @unique @map("github_login")
  name        String?
  avatarUrl   String?      @map("avatar_url")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  memberships Membership[]
  standups    Standup[]
  apiTokens   ApiToken[]
  retroItems  RetroItem[]
  retroVotes  RetroVote[]

  @@map("users")
}

model Team {
  id                        String            @id @default(cuid())
  name                      String
  // GitHub's `full_name` ("owner/name"); webhooks find the team by it (#11).
  // Also unique ignoring case: the index teams_repo_full_name_lower_key on
  // lower(repo_full_name) is raw SQL in its migration, since Prisma can't
  // express it (#94).
  repoFullName              String            @unique @map("repo_full_name")
  // GitHub's numeric repository ID; set on first webhook delivery (#11).
  repoId                    BigInt?           @unique @map("repo_id")
  // Signs this team's GitHub webhook deliveries (decision 005, #115). Kept as
  // is, not hashed: verifying an HMAC needs the key, and the lead copies it
  // from Settings into GitHub. Never returned by the API or logged.
  webhookSecret             String            @map("webhook_secret")
  // true only for teams connected before #115, whose GitHub webhook may still
  // sign with the server-wide GITHUB_WEBHOOK_SECRET. The first delivery signed
  // with webhookSecret turns it off for good (decision 005).
  canUseServerWebhookSecret Boolean           @default(false) @map("can_use_server_webhook_secret")
  timezone                  String            @default("America/Los_Angeles")
  createdAt                 DateTime          @default(now()) @map("created_at")
  updatedAt                 DateTime          @updatedAt @map("updated_at")
  memberships               Membership[]
  sprints                   Sprint[]
  activities                Activity[]
  invites                   Invite[]
  deliveries                WebhookDelivery[]
  standups                  Standup[]

  @@map("teams")
}

model Membership {
  id        String         @id @default(cuid())
  role      MembershipRole @default(MEMBER)
  userId    String         @map("user_id")
  teamId    String         @map("team_id")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([userId])
  @@index([teamId])
  @@map("memberships")
}

model Invite {
  id        String         @id @default(cuid())
  teamId    String         @map("team_id")
  role      MembershipRole
  // Kept as is, not hashed, so the lead can copy the link again from Settings.
  // It expires after 7 days and can be revoked (#7).
  token     String         @unique
  expiresAt DateTime       @map("expires_at")
  revokedAt DateTime?      @map("revoked_at")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  team      Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@map("invites")
}

model Sprint {
  id                String       @id @default(cuid())
  teamId            String       @map("team_id")
  name              String
  startDate         DateTime     @map("start_date") @db.Date
  endDate           DateTime     @map("end_date") @db.Date
  standupsPerPerson Int          @default(3) @map("standups_per_person")
  reviewsPerPerson  Int          @default(5) @map("reviews_per_person")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  team              Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  retro             Retro?
  // Carried in from the previous sprint's retro (#13).
  actionItems       ActionItem[]

  @@index([teamId])
  @@map("sprints")
}

// One retro per sprint (#13). The lead opens it; closing it sets closedAt and
// turns the top 3 "To improve" items into the next sprint's action items
// (rule R6). After that its items and votes don't change.
model Retro {
  id        String      @id @default(cuid())
  sprintId  String      @unique @map("sprint_id")
  closedAt  DateTime?   @map("closed_at")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  sprint    Sprint      @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  items     RetroItem[]

  @@map("retros")
}

model RetroItem {
  id         String      @id @default(cuid())
  retroId    String      @map("retro_id")
  authorId   String      @map("author_id")
  column     RetroColumn
  text       String
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  retro      Retro       @relation(fields: [retroId], references: [id], onDelete: Cascade)
  author     User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  votes      RetroVote[]
  actionItem ActionItem?

  @@index([retroId])
  @@index([authorId])
  @@map("retro_items")
}

// Max 1 vote per member per item; the 3 per retro are checked when voting (rule R6).
model RetroVote {
  id        String    @id @default(cuid())
  itemId    String    @map("item_id")
  userId    String    @map("user_id")
  createdAt DateTime  @default(now()) @map("created_at")
  item      RetroItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([itemId, userId])
  @@index([userId])
  @@map("retro_votes")
}

// A "To improve" item carried into the next sprint when its retro closed. Its
// text and votes stay on the retro item, which no longer changes.
model ActionItem {
  id          String    @id @default(cuid())
  sprintId    String    @map("sprint_id")
  retroItemId String    @unique @map("retro_item_id")
  isDone      Boolean   @default(false) @map("is_done")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  sprint      Sprint    @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  retroItem   RetroItem @relation(fields: [retroItemId], references: [id], onDelete: Cascade)

  @@index([sprintId])
  @@map("action_items")
}

// A standup belongs to its team and day. It's listed under the sprint whose
// dates contain that day, so it follows its day when sprint dates change (#56).
model Standup {
  id        String   @id @default(cuid())
  teamId    String   @map("team_id")
  userId    String   @map("user_id")
  date      DateTime @db.Date
  yesterday String
  today     String
  blockers  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId, date])
  @@index([teamId, date])
  @@index([userId])
  @@map("standups")
}

model Activity {
  id            String       @id @default(cuid())
  teamId        String       @map("team_id")
  type          ActivityType
  actorLogin    String       @map("actor_login")
  prNumber      Int?         @map("pr_number")
  prAuthorLogin String?      @map("pr_author_login")
  sha           String?
  title         String?
  // Only REVIEW rows have a state. Reviews stored before #57, and reviews with
  // a state GitHub doesn't document, have none and still count.
  reviewState   ReviewState? @map("review_state")
  // Only COMMIT rows have a key: a hash of the author, author date and full
  // message, so a rebased or amended copy under a new SHA is stored once (#114).
  // Commits stored before #114, or whose payload left out the author's date,
  // have none and are deduplicated by SHA only.
  commitKey     String?      @map("commit_key")
  occurredAt    DateTime     @map("occurred_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  team          Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, type, sha])
  @@unique([teamId, commitKey])
  @@index([teamId])
  @@index([actorLogin])
  @@map("activities")
}

model WebhookDelivery {
  id          String   @id
  teamId      String?  @map("team_id")
  event       String
  deliveredAt DateTime @default(now()) @map("delivered_at")
  team        Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@map("webhook_deliveries")
}

// Personal tokens for the public API (#16). Only the SHA-256 hash is stored;
// the token itself is shown once (AGENTS.md §4 Security). last4 lets Settings
// tell tokens apart. Revoking deletes the row.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  name       String
  tokenHash  String    @unique @map("token_hash")
  last4      String
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_tokens")
}
